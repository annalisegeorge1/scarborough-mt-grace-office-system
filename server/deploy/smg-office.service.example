[Unit]
Description=Scarborough Mt Grace District Office Web Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/smg-office/server
EnvironmentFile=/etc/smg-office.env
ExecStart=/usr/bin/node src/app.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/smg-office/server/storage/private

[Install]
WantedBy=multi-user.target
